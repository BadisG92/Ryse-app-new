<?xml version="1.0" encoding="utf-8"?>
<!-- The home in miniature: what is left, its gauge, and the five slots of
     the day in their three states. Every colour is the edition's, set at
     runtime by RyseMealWidget.kt: the ground and its edge, the grounds and
     edges of the slots, are ImageViews, because a tint is the only colour
     RemoteViews can change on a shape. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/card_fill"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/ground_edge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/card_edge"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:fontFamily="@font/instrument_sans"
                android:fontVariationSettings="'wght' 600"
                android:textColor="@color/ryze_mute"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/figure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="34sp"
                    android:fontFamily="@font/archivo"
                    android:fontVariationSettings="'wght' 800"
                    android:letterSpacing="-0.028"
                    android:includeFontPadding="false"
                    android:textColor="@color/ryze_ink"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text=""
                    android:textSize="12sp"
                    android:fontFamily="@font/instrument_sans"
                    android:fontVariationSettings="'wght' 600"
                    android:textColor="@color/ryze_mute" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingTop="3dp"
            android:gravity="end"
            android:text=""
            android:textSize="10.5sp"
            android:fontFamily="@font/instrument_sans"
            android:textColor="@color/ryze_mute"
            android:maxLines="2" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/gauge"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/gauge_amber"
        android:max="100"
        android:progress="0" />

    <LinearLayout
        android:id="@+id/slots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <FrameLayout
            android:id="@+id/slot_1"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp">
            <ImageView android:id="@+id/slot_1_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tile_fill" android:contentDescription="@null" />
            <ImageView android:id="@+id/slot_1_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tile_edge" android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <ImageView android:id="@+id/slot_1_icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_sunrise" android:contentDescription="@null" />
                <TextView android:id="@+id/slot_1_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="" android:textSize="9.5sp" android:fontFamily="@font/instrument_sans" android:fontVariationSettings="'wght' 600" android:textColor="@color/ryze_mute" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/slot_1_word" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="8.5sp" android:fontFamily="@font/instrument_sans" android:textColor="@color/ryze_mute2" android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/slot_2"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp">
            <ImageView android:id="@+id/slot_2_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tile_fill" android:contentDescription="@null" />
            <ImageView android:id="@+id/slot_2_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tile_edge" android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <ImageView android:id="@+id/slot_2_icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_sun" android:contentDescription="@null" />
                <TextView android:id="@+id/slot_2_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="" android:textSize="9.5sp" android:fontFamily="@font/instrument_sans" android:fontVariationSettings="'wght' 600" android:textColor="@color/ryze_mute" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/slot_2_word" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="8.5sp" android:fontFamily="@font/instrument_sans" android:textColor="@color/ryze_mute2" android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/slot_3"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp">
            <ImageView android:id="@+id/slot_3_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tile_fill" android:contentDescription="@null" />
            <ImageView android:id="@+id/slot_3_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tile_edge" android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <ImageView android:id="@+id/slot_3_icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_cookie" android:contentDescription="@null" />
                <TextView android:id="@+id/slot_3_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="" android:textSize="9.5sp" android:fontFamily="@font/instrument_sans" android:fontVariationSettings="'wght' 600" android:textColor="@color/ryze_mute" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/slot_3_word" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="8.5sp" android:fontFamily="@font/instrument_sans" android:textColor="@color/ryze_mute2" android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/slot_4"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp">
            <ImageView android:id="@+id/slot_4_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tile_fill" android:contentDescription="@null" />
            <ImageView android:id="@+id/slot_4_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/tile_edge" android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <ImageView android:id="@+id/slot_4_icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_sunset" android:contentDescription="@null" />
                <TextView android:id="@+id/slot_4_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="" android:textSize="9.5sp" android:fontFamily="@font/instrument_sans" android:fontVariationSettings="'wght' 600" android:textColor="@color/ryze_mute" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/slot_4_word" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="8.5sp" android:fontFamily="@font/instrument_sans" android:textColor="@color/ryze_mute2" android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/slot_5"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1">
            <ImageView android:id="@+id/slot_5_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/pill_fill" android:contentDescription="@null" />
            <ImageView android:id="@+id/slot_5_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/pill_edge" android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <ImageView android:id="@+id/slot_5_icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_dumbbell" android:contentDescription="@null" />
                <TextView android:id="@+id/slot_5_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="" android:textSize="9.5sp" android:fontFamily="@font/instrument_sans" android:fontVariationSettings="'wght' 600" android:textColor="@color/ryze_mute" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/slot_5_word" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="8.5sp" android:fontFamily="@font/instrument_sans" android:textColor="@color/ryze_mute2" android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    </LinearLayout>

</FrameLayout>
