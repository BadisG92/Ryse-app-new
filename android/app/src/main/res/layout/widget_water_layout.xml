<?xml version="1.0" encoding="utf-8"?>
<!-- The day's water as glasses, and two buttons that write. Twelve glasses
     are drawn here; RyseWaterWidget.kt shows as many as the goal needs
     (four to twelve) and tints them by state. The ground is a tinted shape:
     the edition's paper, or its ink once the goal is reached. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_water_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/card_fill"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/ground_edge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/card_edge"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/water_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="11sp"
                android:fontFamily="@font/instrument_sans"
                android:fontVariationSettings="'wght' 600"
                android:textColor="@color/ryze_mute"
                android:maxLines="1" />

            <TextView
                android:id="@+id/water_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="17sp"
                android:fontFamily="@font/archivo"
                android:fontVariationSettings="'wght' 800"
                android:letterSpacing="-0.028"
                android:includeFontPadding="false"
                android:textColor="@color/ryze_ink"
                android:maxLines="1" />

            <TextView
                android:id="@+id/water_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text=""
                android:textSize="12sp"
                android:fontFamily="@font/instrument_sans"
                android:fontVariationSettings="'wght' 600"
                android:textColor="@color/ryze_mute"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/glasses"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="bottom">

            <ImageView android:id="@+id/glass_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:src="@drawable/glass_empty" android:contentDescription="@null" />
            <ImageView android:id="@+id/glass_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:scaleType="fitCenter" android:src="@drawable/glass_empty" android:contentDescription="@null" />
            <ImageView android:id="@+id/glass_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:scaleType="fitCenter" android:src="@drawable/glass_empty" android:contentDescription="@null" />
            <ImageView android:id="@+id/glass_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:scaleType="fitCenter" android:src="@drawable/glass_empty" android:contentDescription="@null" />
            <ImageView android:id="@+id/glass_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:scaleType="fitCenter" android:src="@drawable/glass_empty" android:contentDescription="@null" />
            <ImageView android:id="@+id/glass_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:scaleType="fitCenter" android:src="@drawable/glass_empty" android:contentDescription="@null" />
            <ImageView android:id="@+id/glass_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:scaleType="fitCenter" android:src="@drawable/glass_empty" android:contentDescription="@null" />
            <ImageView android:id="@+id/glass_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:scaleType="fitCenter" android:src="@drawable/glass_empty" android:contentDescription="@null" />
            <ImageView android:id="@+id/glass_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:scaleType="fitCenter" android:src="@drawable/glass_empty" android:visibility="gone" android:contentDescription="@null" />
            <ImageView android:id="@+id/glass_10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:scaleType="fitCenter" android:src="@drawable/glass_empty" android:visibility="gone" android:contentDescription="@null" />
            <ImageView android:id="@+id/glass_11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:scaleType="fitCenter" android:src="@drawable/glass_empty" android:visibility="gone" android:contentDescription="@null" />
            <ImageView android:id="@+id/glass_12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:scaleType="fitCenter" android:src="@drawable/glass_empty" android:visibility="gone" android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_glass_one"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView android:id="@+id/btn_glass_one_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/pill_fill" android:contentDescription="@null" />
                <TextView
                    android:id="@+id/btn_glass_one_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text=""
                    android:textSize="11.5sp"
                    android:fontFamily="@font/instrument_sans"
                    android:fontVariationSettings="'wght' 600"
                    android:textColor="@color/ryze_paper"
                    android:maxLines="1" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_glass_two"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp">
                <ImageView android:id="@+id/btn_glass_two_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/pill_fill" android:contentDescription="@null" />
                <ImageView android:id="@+id/btn_glass_two_edge" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/pill_edge" android:contentDescription="@null" />
                <TextView
                    android:id="@+id/btn_glass_two_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text=""
                    android:textSize="11.5sp"
                    android:fontFamily="@font/instrument_sans"
                    android:fontVariationSettings="'wght' 600"
                    android:textColor="@color/ryze_ink"
                    android:maxLines="1" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
