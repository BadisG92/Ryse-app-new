<?xml version="1.0" encoding="utf-8"?>
<!-- Small by default; wide enough, the widget adds the grid of the 90 days
     (RyzeArcWidget.kt picks the layout by size). Every half hour at most, so
     that after midnight the day reads as waiting for the app. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_arc_small"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_arc_description" />
