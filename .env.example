# ===================================
# RYZE APP - ENVIRONMENT VARIABLES
# ===================================
#
# INSTRUCTIONS:
# 1. Copier ce fichier en .env.local
# 2. Remplir avec vos VRAIES clés (JAMAIS commiter .env.local)
# 3. Pour production: créer .env.production
#
# ===================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Vision API
GOOGLE_VISION_API_KEY=your_google_vision_key_here

# Google OAuth (from Info.plist)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.your_reversed_id

# Apple OAuth (optionnel)
APPLE_CLIENT_ID=com.BadisG.ryzeApp

# RevenueCat API Keys (from RevenueCat Dashboard)
REVENUECAT_APPLE_API_KEY=your_revenuecat_apple_key_here
# For testing, use: test_deHjRXFqZzkmjDnmhLwgTEmxUzS
REVENUECAT_GOOGLE_API_KEY=your_revenuecat_google_key_here

# Environment Type
ENVIRONMENT=development
# Options: development, staging, production

# Feature Flags
TEST_MODE=true
# IMPORTANT: Mettre à false en PRODUCTION pour activer les vrais paiements

# Debug
ENABLE_DEBUG_LOGS=true
# Mettre à false en production pour désactiver les logs
