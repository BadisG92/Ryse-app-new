import 'package:flutter/material.dart';
import 'package:lucide_icons_flutter/lucide_icons.dart';
import 'package:camera/camera.dart';
import 'package:provider/provider.dart';
import '../services/localization_service.dart';
import '../services/openfoodfacts_service.dart';
import '../services/barcode_detection_service.dart';
import '../models/openfoodfacts_models.dart';
import '../models/nutrition_models.dart' as nutrition_models;
import '../config/google_vision_config.dart';

/// Scanner de code-barres optimisé avec tap-to-focus
/// Mode tap-to-scan uniquement : 1 appel API par scan
class BarcodeScannerScreen extends StatefulWidget {
  final bool isFromDashboard;
  final Function(dynamic)? onFoodScanned;

  const BarcodeScannerScreen({
    super.key,
    this.isFromDashboard = false,
    this.onFoodScanned,
  });

  @override
  State<BarcodeScannerScreen> createState() => _BarcodeScannerScreenState();
}

class _BarcodeScannerScreenState extends State<BarcodeScannerScreen> {
  CameraController? controller;
  bool isPermissionGranted = false;
  bool isLoading = true;
  bool isProcessing = false;

  // Focus indicator (tap-to-focus comme iPhone)
  Offset? _focusPoint;
  bool _isFocusIndicatorVisible = false;

  @override
  void initState() {
    super.initState();
    _initializeCamera();
  }

  Future<void> _initializeCamera() async {
    try {
      debugPrint('🔍 [SCANNER] Initialisation caméra');

      final cameras = await availableCameras();
      if (cameras.isEmpty) {
        setState(() {
          isPermissionGranted = true;
          isLoading = false;
        });
        return;
      }

      controller = CameraController(
        cameras.first,
        ResolutionPreset.high, // High resolution pour meilleure netteté
        enableAudio: false,
      );

      await controller!.initialize();

      // Activer l'autofocus par défaut
      await controller!.setFocusMode(FocusMode.auto);

      debugPrint('✅ [SCANNER] Caméra initialisée');

      if (mounted) {
        setState(() {
          isPermissionGranted = true;
          isLoading = false;
        });
      }
    } catch (e) {
      debugPrint('❌ [SCANNER] Erreur caméra: $e');
      setState(() {
        isPermissionGranted = false;
        isLoading = false;
      });
    }
  }

  @override
  void dispose() {
    controller?.dispose();
    super.dispose();
  }

  /// Afficher l'indicateur de focus (carré jaune comme iPhone)
  void _showFocusIndicator(Offset position) {
    setState(() {
      _focusPoint = position;
      _isFocusIndicatorVisible = true;
    });

    // Cacher l'indicateur après 1 seconde
    Future.delayed(const Duration(milliseconds: 1000), () {
      if (mounted) {
        setState(() {
          _isFocusIndicatorVisible = false;
        });
      }
    });
  }

  /// Scanner le code-barres (1 seul appel API)
  Future<void> _scanBarcode() async {
    if (isProcessing) return;

    setState(() {
      isProcessing = true;
    });

    try {
      if (!GoogleVisionConfig.isConfigured) {
        // Mode test
        debugPrint('⚠️ [SCANNER] Vision API non configurée, utilisation code test');
        const mockBarcode = '3017620422003'; // Nutella
        await _handleScannedBarcode(mockBarcode);
        return;
      }

      // Capturer une image haute résolution
      if (controller != null && controller!.value.isInitialized) {
        final image = await controller!.takePicture();
        final imageBytes = await image.readAsBytes();

        debugPrint('📸 [SCANNER] Image capturée, détection en cours...');

        // Détecter le code-barres avec Vision API (1 appel)
        final barcode = await BarcodeDetectionService.detectBarcode(imageBytes);

        if (!mounted) return;

        if (barcode != null) {
          debugPrint('✅ [SCANNER] Code-barres détecté: $barcode');
          await _handleScannedBarcode(barcode);
        } else {
          debugPrint('⚠️ [SCANNER] Aucun code-barres détecté');
          final locService = Provider.of<LocalizationService>(context, listen: false);
          _showErrorDialog(
            locService.currentLanguageCode == 'fr'
              ? 'Aucun code-barres détecté.\n\nConseils :\n• Touchez l\'écran pour faire la mise au point\n• Assurez-vous que le code-barres est bien éclairé\n• Centrez le code-barres dans le cadre blanc'
              : 'No barcode detected.\n\nTips:\n• Tap the screen to focus\n• Make sure the barcode is well lit\n• Center the barcode in the white frame'
          );
          setState(() {
            isProcessing = false;
          });
        }
      }
    } catch (e) {
      debugPrint('❌ [SCANNER] Erreur scan: $e');
      if (mounted) {
        setState(() {
          isProcessing = false;
        });
      }
    }
  }

  Future<void> _handleScannedBarcode(String barcode) async {
    try {
      debugPrint('🔍 [SCANNER] Recherche produit: $barcode');

      // Recherche sur OpenFoodFacts
      final product = await OpenFoodFactsService.getProduct(barcode);

      if (!mounted) return;

      if (OpenFoodFactsService.isProductFound(product)) {
        debugPrint('✅ [SCANNER] Produit trouvé: ${product.productName}');
        _showProductFoundDialog(product);
      } else {
        debugPrint('❌ [SCANNER] Produit non trouvé');
        final locService = Provider.of<LocalizationService>(context, listen: false);
        _showErrorDialog(
          locService.currentLanguageCode == 'fr'
            ? 'Produit non trouvé dans la base de données OpenFoodFacts'
            : 'Product not found in OpenFoodFacts database'
        );
        setState(() {
          isProcessing = false;
        });
      }
    } catch (e) {
      debugPrint('❌ [SCANNER] Erreur recherche: $e');
      if (mounted) {
        final locService = Provider.of<LocalizationService>(context, listen: false);
        _showErrorDialog(
          locService.currentLanguageCode == 'fr'
            ? 'Erreur lors de la recherche: $e'
            : 'Error during search: $e'
        );
        setState(() {
          isProcessing = false;
        });
      }
    }
  }

  void _showProductFoundDialog(OpenFoodFactsProduct product) {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (context) => AlertDialog(
        title: Row(
          children: [
            const Icon(Icons.check_circle, color: Colors.green, size: 28),
            const SizedBox(width: 12),
            Expanded(
              child: Consumer<LocalizationService>(
                builder: (context, locService, child) => Text(
                  locService.currentLanguageCode == 'fr'
                    ? 'Produit trouvé !'
                    : 'Product found!',
                  style: const TextStyle(fontSize: 18),
                ),
              ),
            ),
          ],
        ),
        content: SingleChildScrollView(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              // Image
              if (product.imageUrl != null)
                Center(
                  child: ClipRRect(
                    borderRadius: BorderRadius.circular(8),
                    child: Image.network(
                      product.imageUrl!,
                      height: 120,
                      width: 120,
                      fit: BoxFit.cover,
                      errorBuilder: (context, error, stackTrace) =>
                        Container(
                          height: 120,
                          width: 120,
                          color: Colors.grey[200],
                          child: const Icon(Icons.fastfood, size: 48, color: Colors.grey),
                        ),
                    ),
                  ),
                ),

              const SizedBox(height: 16),

              // Nom
              Text(
                product.productName ?? 'Produit sans nom',
                style: const TextStyle(
                  fontSize: 16,
                  fontWeight: FontWeight.bold,
                ),
              ),

              const SizedBox(height: 8),

              // Marque
              if (product.brands != null)
                Text(
                  product.brands!,
                  style: TextStyle(
                    fontSize: 14,
                    color: Colors.grey[600],
                  ),
                ),

              const SizedBox(height: 12),

              // Nutrition
              if (product.nutriments != null) ...[
                if (product.nutriments!.caloriesPer100g > 0)
                  _buildNutrientRow('Calories', '${product.nutriments!.caloriesPer100g.toStringAsFixed(0)} kcal/100g'),
                if (product.nutriments!.proteinsPer100g > 0)
                  _buildNutrientRow('Protéines', '${product.nutriments!.proteinsPer100g.toStringAsFixed(1)} g/100g'),
                if (product.nutriments!.carbohydratesPer100g > 0)
                  _buildNutrientRow('Glucides', '${product.nutriments!.carbohydratesPer100g.toStringAsFixed(1)} g/100g'),
                if (product.nutriments!.fatPer100g > 0)
                  _buildNutrientRow('Lipides', '${product.nutriments!.fatPer100g.toStringAsFixed(1)} g/100g'),
              ],

              const SizedBox(height: 8),

              // Code-barres
              if (product.barcode != null)
                Container(
                  padding: const EdgeInsets.all(8),
                  decoration: BoxDecoration(
                    color: Colors.grey[100],
                    borderRadius: BorderRadius.circular(4),
                  ),
                  child: Text(
                    'Code: ${product.barcode}',
                    style: const TextStyle(
                      fontFamily: 'monospace',
                      fontSize: 12,
                      color: Colors.grey,
                    ),
                  ),
                ),
            ],
          ),
        ),
        actions: [
          TextButton(
            onPressed: () {
              Navigator.of(context).pop();
              setState(() {
                isProcessing = false;
              });
            },
            child: Consumer<LocalizationService>(
              builder: (context, locService, child) => Text(
                locService.currentLanguageCode == 'fr'
                  ? 'Scanner un autre'
                  : 'Scan another',
              ),
            ),
          ),
          ElevatedButton(
            onPressed: () {
              if (widget.isFromDashboard && widget.onFoodScanned != null) {
                // Convertir le produit OpenFoodFacts en FoodItem
                final foodItem = nutrition_models.FoodItem(
                  name: product.productName ?? 'Produit scanné',
                  calories: (product.nutriments?.caloriesPer100g ?? 0).round(),
                  proteins: product.nutriments?.proteinsPer100g ?? 0.0,
                  carbs: product.nutriments?.carbohydratesPer100g ?? 0.0,
                  fats: product.nutriments?.fatPer100g ?? 0.0,
                  portion: '100 g',
                  isScanned: true,
                );
                widget.onFoodScanned!(foodItem);
              }
              // Fermer seulement le dialogue, pas le scanner
              Navigator.of(context).pop();
              // Réinitialiser l'état pour permettre un nouveau scan
              setState(() {
                isProcessing = false;
              });
            },
            style: ElevatedButton.styleFrom(
              backgroundColor: Colors.green,
            ),
            child: Consumer<LocalizationService>(
              builder: (context, locService, child) => Text(
                locService.currentLanguageCode == 'fr'
                  ? 'Ajouter'
                  : 'Add',
                style: const TextStyle(color: Colors.white),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildNutrientRow(String label, String value) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 2),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(label, style: const TextStyle(fontSize: 14)),
          Text(
            value,
            style: const TextStyle(
              fontSize: 14,
              fontWeight: FontWeight.w600,
            ),
          ),
        ],
      ),
    );
  }

  void _showErrorDialog(String message) {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: Consumer<LocalizationService>(
          builder: (context, locService, child) => Text(
            locService.currentLanguageCode == 'fr' ? 'Erreur' : 'Error',
          ),
        ),
        content: Text(message),
        actions: [
          TextButton(
            onPressed: () {
              Navigator.of(context).pop();
              setState(() {
                isProcessing = false;
              });
            },
            child: const Text('OK'),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Consumer<LocalizationService>(
          builder: (context, locService, child) => Text(
            locService.currentLanguageCode == 'fr'
              ? 'Scanner de codes-barres'
              : 'Barcode Scanner',
          ),
        ),
        backgroundColor: Colors.white,
        elevation: 0,
        iconTheme: const IconThemeData(color: Colors.black),
        titleTextStyle: const TextStyle(
          color: Colors.black,
          fontSize: 18,
          fontWeight: FontWeight.w600,
        ),
        actions: [
          if (isPermissionGranted && !isLoading && controller != null)
            IconButton(
              icon: const Icon(LucideIcons.flashlight, color: Colors.black),
              tooltip: 'Flash',
              onPressed: () async {
                try {
                  await controller!.setFlashMode(
                    controller!.value.flashMode == FlashMode.off
                      ? FlashMode.torch
                      : FlashMode.off
                  );
                  setState(() {});
                } catch (e) {
                  debugPrint('⚠️ Flash non supporté');
                }
              },
            ),
        ],
      ),
      body: _buildBody(),
    );
  }

  Widget _buildBody() {
    if (isLoading) {
      return Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const CircularProgressIndicator(),
            const SizedBox(height: 16),
            Consumer<LocalizationService>(
              builder: (context, locService, child) => Text(
                locService.currentLanguageCode == 'fr'
                  ? 'Initialisation de la caméra...'
                  : 'Initializing camera...',
              ),
            ),
          ],
        ),
      );
    }

    if (!isPermissionGranted) {
      return Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Icon(LucideIcons.camera, size: 64, color: Colors.grey),
            const SizedBox(height: 16),
            Consumer<LocalizationService>(
              builder: (context, locService, child) => Text(
                locService.currentLanguageCode == 'fr'
                  ? 'Permission caméra requise'
                  : 'Camera permission required',
                style: const TextStyle(fontSize: 18, fontWeight: FontWeight.w600),
              ),
            ),
            const SizedBox(height: 24),
            ElevatedButton(
              onPressed: () async {
                setState(() => isLoading = true);
                await _initializeCamera();
              },
              child: Consumer<LocalizationService>(
                builder: (context, locService, child) => Text(
                  locService.currentLanguageCode == 'fr'
                    ? 'Réessayer'
                    : 'Try again',
                ),
              ),
            ),
          ],
        ),
      );
    }

    return Stack(
      children: [
        // Camera preview avec tap-to-focus
        if (controller != null && controller!.value.isInitialized)
          Positioned.fill(
            child: GestureDetector(
              onTapDown: (TapDownDetails details) async {
                // Tap-to-focus comme iPhone
                final RenderBox box = context.findRenderObject() as RenderBox;
                final Offset localPosition = box.globalToLocal(details.globalPosition);
                final double x = localPosition.dx / box.size.width;
                final double y = localPosition.dy / box.size.height;

                try {
                  await controller!.setFocusPoint(Offset(x, y));
                  await controller!.setExposurePoint(Offset(x, y));
                  debugPrint('📍 Focus réglé: ($x, $y)');

                  // Feedback visuel
                  _showFocusIndicator(details.globalPosition);
                } catch (e) {
                  debugPrint('⚠️ Erreur focus: $e');
                }
              },
              child: CameraPreview(controller!),
            ),
          ),

        // Overlay avec cadre et instructions
        _buildScannerOverlay(),

        // Indicateur de focus (carré jaune)
        if (_isFocusIndicatorVisible && _focusPoint != null)
          Positioned(
            left: _focusPoint!.dx - 40,
            top: _focusPoint!.dy - 40,
            child: Container(
              width: 80,
              height: 80,
              decoration: BoxDecoration(
                border: Border.all(color: Colors.yellow, width: 2),
                borderRadius: BorderRadius.circular(40),
              ),
            ),
          ),

        // Processing indicator
        if (isProcessing)
          Container(
            color: Colors.black54,
            child: Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  const CircularProgressIndicator(color: Colors.white),
                  const SizedBox(height: 16),
                  Consumer<LocalizationService>(
                    builder: (context, locService, child) => Text(
                      locService.currentLanguageCode == 'fr'
                        ? 'Détection en cours...'
                        : 'Detecting...',
                      style: const TextStyle(color: Colors.white, fontSize: 16),
                    ),
                  ),
                ],
              ),
            ),
          ),
      ],
    );
  }

  Widget _buildScannerOverlay() {
    return Positioned.fill(
      child: Column(
        children: [
          // Zone sombre du haut
          Expanded(
            flex: 2,
            child: Container(
              color: Colors.black54,
              child: Center(
                child: Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 20),
                  child: Consumer<LocalizationService>(
                    builder: (context, locService, child) => Text(
                      locService.currentLanguageCode == 'fr'
                        ? '💡 Touchez l\'écran pour faire la mise au point'
                        : '💡 Tap the screen to focus',
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 14,
                      ),
                      textAlign: TextAlign.center,
                    ),
                  ),
                ),
              ),
            ),
          ),

          // Cadre de scan
          Container(
            height: 200,
            margin: const EdgeInsets.symmetric(horizontal: 40),
            decoration: BoxDecoration(
              border: Border.all(color: Colors.white, width: 3),
              borderRadius: BorderRadius.circular(12),
            ),
            child: Stack(
              children: [
                // Coins verts
                _buildCorner(top: 0, left: 0, topBorder: true, leftBorder: true),
                _buildCorner(top: 0, right: 0, topBorder: true, rightBorder: true),
                _buildCorner(bottom: 0, left: 0, bottomBorder: true, leftBorder: true),
                _buildCorner(bottom: 0, right: 0, bottomBorder: true, rightBorder: true),

                // Bouton scan au centre
                Center(
                  child: GestureDetector(
                    onTap: isProcessing ? null : _scanBarcode,
                    child: Container(
                      padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 12),
                      decoration: BoxDecoration(
                        color: isProcessing
                          ? Colors.grey.withValues(alpha: 0.9)
                          : Colors.green.withValues(alpha: 0.9),
                        borderRadius: BorderRadius.circular(24),
                        boxShadow: [
                          BoxShadow(
                            color: Colors.black.withValues(alpha: 0.3),
                            blurRadius: 8,
                            offset: const Offset(0, 2),
                          ),
                        ],
                      ),
                      child: Row(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          Icon(
                            isProcessing ? Icons.hourglass_empty : Icons.qr_code_scanner,
                            color: Colors.white,
                            size: 20,
                          ),
                          const SizedBox(width: 8),
                          Consumer<LocalizationService>(
                            builder: (context, locService, child) => Text(
                              locService.currentLanguageCode == 'fr'
                                ? (isProcessing ? 'Scan en cours...' : 'Toucher pour scanner')
                                : (isProcessing ? 'Scanning...' : 'Tap to scan'),
                              style: const TextStyle(
                                color: Colors.white,
                                fontSize: 16,
                                fontWeight: FontWeight.w600,
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
              ],
            ),
          ),

          // Zone sombre du bas avec instructions
          Expanded(
            flex: 2,
            child: Container(
              color: Colors.black54,
              child: Center(
                child: Padding(
                  padding: const EdgeInsets.all(20),
                  child: Consumer<LocalizationService>(
                    builder: (context, locService, child) => Text(
                      locService.currentLanguageCode == 'fr'
                        ? 'Centrez le code-barres dans le cadre blanc\npuis touchez le bouton vert'
                        : 'Center the barcode in the white frame\nthen tap the green button',
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 15,
                      ),
                      textAlign: TextAlign.center,
                    ),
                  ),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildCorner({
    double? top,
    double? left,
    double? bottom,
    double? right,
    bool topBorder = false,
    bool leftBorder = false,
    bool bottomBorder = false,
    bool rightBorder = false,
  }) {
    return Positioned(
      top: top,
      left: left,
      bottom: bottom,
      right: right,
      child: Container(
        width: 25,
        height: 25,
        decoration: BoxDecoration(
          border: Border(
            top: topBorder ? const BorderSide(color: Colors.green, width: 4) : BorderSide.none,
            left: leftBorder ? const BorderSide(color: Colors.green, width: 4) : BorderSide.none,
            bottom: bottomBorder ? const BorderSide(color: Colors.green, width: 4) : BorderSide.none,
            right: rightBorder ? const BorderSide(color: Colors.green, width: 4) : BorderSide.none,
          ),
        ),
      ),
    );
  }
}
