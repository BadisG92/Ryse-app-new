# Environment variables - NEVER COMMIT THESE
.env
.env.local
.env.production
.env.staging
.env.development
.env.test
*.env

# ⚠️ SECURITY - API Keys & Secrets - NEVER COMMIT
# Les anciennes configurations hardcodées sont maintenant migrées
# vers EnvConfig qui utilise --dart-define-from-file
lib/config/API_KEYS_BACKUP.txt
**/API_KEYS*.txt
**/secrets*.txt
**/*_secret*.txt
**/*_credentials*.json
**/*_private_key*.json

# Claude settings (may contain sensitive permissions)
.claude/settings.local.json

# API documentation (may contain test keys)
API_STATUS_REPORT.md
FINAL_API_STATUS.md

# Firebase - NEVER COMMIT CONFIG FILES
**/GoogleService-Info.plist
**/google-services.json
firebase-debug.log
.firebase/

# Android Release Signing - NEVER COMMIT
android/key.properties
android/app/*.jks
android/app/*.keystore
*.jks
*.keystore

# Database
*.sqlite
*.sqlite3
*.db

# Logs
logs/
*.log

# Cache
.cache/
*.cache


# Fichier temporaire avec clés hardcodées - NE JAMAIS COMMITER
lib/config/env_config.dart.backup
lib/config/env_config_temp.dart
